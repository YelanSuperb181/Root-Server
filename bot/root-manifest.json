{
  "id": "your-bot-id",
  "version": "1.0.0",
  "package": {
    "server": {
      "launch": "dist/main.js",
      "deploy": ["dist"],
      "nodeModules": ["node_modules"]
    }
  },
  "permissions": {
    "community": {
      "manageRoles": true,
      "createChannelGroup": true
    },
    "channel": {
      "fullControl": true,
      "view": true,
      "viewMessageHistory": true,
      "createMessage": true,
      "createMessageMention": true,
      "createMessageReaction": true,
      "deleteMessageOther": true,
      "managePinnedMessages": true
    }
  }
}
