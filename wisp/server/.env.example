# Copy this file to server/.env and paste the DEV_TOKEN from the Root Developer Portal.
# The token points devhost at your test community. Never commit .env.
DEV_TOKEN=TODO-your-token-here

# Optional, for trying Wisp's brain while developing (in Root, paste the key
# into Wisp's App settings instead): an Anthropic API key from
# console.anthropic.com. Without it Wisp reacts with keywords.
# ANTHROPIC_API_KEY=
