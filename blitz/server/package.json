{
  "name": "@blitz/server",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@blitz/shared": "*"
  },
  "scripts": {
    "build": "tsc",
    "server": "node ../dev-manifest.js && rootsdk-devhost --project-folder=../ --manifest=root-manifest.dev.json",
