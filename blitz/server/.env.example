# `npm run configure` writes this file for you. To do it by hand, copy this
# file to server/.env and paste in your DEV_TOKEN and Blitz's App ID from the
# Root Developer Portal. The token points devhost at your test community.
# Never commit .env or share the token.
DEV_TOKEN=TODO-your-token-here
BLITZ_APP_ID=

# `npm run upload` saves your publishing token here as BLITZ_UPLOAD_TOKEN, and
# the last version it uploaded as BLITZ_LAST_VERSION.

# Optional, for trying Blitz's brain while developing (in Root, paste the key
# into Blitz's App settings instead): an Anthropic API key from
# console.anthropic.com. Without it Blitz reacts with keywords.
# ANTHROPIC_API_KEY=
